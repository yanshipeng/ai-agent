DEEPSEEK_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_THINKING=disabled
REQUESTS_JSONL_PATH=./requests.jsonl
# Day18：Agent 逐步 Trace（与 requests.jsonl 并列）
TRACES_JSONL_PATH=./traces.jsonl
APP_VERSION=0.1.0ba
KB_INDEX_DIR=data/stability_kb/index
RAG_TOP_K=5
# Day16：混合检索（向量占比 / 融合分阈值）
RAG_HYBRID_WEIGHT=0.6
RAG_MIN_SCORE=0.05
AGENT_MAX_STEPS=5
AGENT_MAX_TOTAL_TIME_MS=20000
AGENT_ON_MAX_STEPS=rag
AGENT_TOOL_TIMEOUT_SECONDS=10
# Day18：Agent context token 预算（启发式）
AGENT_MAX_CONTEXT_TOKENS=6000
SESSION_MAX_TURNS=8
SESSION_MAX_CHARS=20000
SESSION_TOOL_RESULT_MAX_CHARS=4000
SESSION_CONTENT_MAX_CHARS=8000
SESSION_ENABLE_SUMMARY=true
SESSION_SUMMARY_USE_LLM=false
SESSION_TTL_SECONDS=3600
