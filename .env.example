DEEPSEEK_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Day20：低置信度/高质量请求时改用的模型
LLM_MODEL_PRO=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_THINKING=disabled
REQUESTS_JSONL_PATH=./data/runtime/requests.jsonl
# Day18：Agent 逐步 Trace（与 requests.jsonl 并列）
TRACES_JSONL_PATH=./data/runtime/traces.jsonl
APP_VERSION=0.1.0ba
KB_INDEX_DIR=data/stability_kb/index
RAG_TOP_K=5
# Day16：混合检索（向量占比 / 融合分阈值）
RAG_HYBRID_WEIGHT=0.6
RAG_MIN_SCORE=0.05
# Day20：Top1 hybrid score 低于此 → 路由 pro
RAG_ROUTE_PRO_MIN_SCORE=0.35
AGENT_MAX_STEPS=5
AGENT_MAX_TOTAL_TIME_MS=20000
AGENT_ON_MAX_STEPS=rag
AGENT_TOOL_TIMEOUT_SECONDS=10
# Day18：Agent context token 预算（启发式）
AGENT_MAX_CONTEXT_TOKENS=6000
SESSION_MAX_TURNS=8
SESSION_MAX_CHARS=20000
SESSION_TOOL_RESULT_MAX_CHARS=4000
SESSION_CONTENT_MAX_CHARS=8000
SESSION_ENABLE_SUMMARY=true
SESSION_SUMMARY_USE_LLM=false
SESSION_TTL_SECONDS=3600
# Day22：鉴权（生产务必 true；本地演示可先 false）
API_AUTH_ENABLED=true
# key:role，逗号分隔；admin 可 ingest/eval，reader 仅 ask
API_KEYS=dev-admin-key:admin,dev-reader-key:reader
# Day23：版本化入库
KB_VERSIONS_DIR=data/stability_kb/versions
KB_DOCS_PATH=data/stability_kb/docs.jsonl
# Day24：限流 + 单次请求 token 预算（代码默认 false；上线请 true）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TOKEN_BUDGET=1024
REQUEST_BUDGET_TOP_K_CAP=3
# Day25：反馈闭环
FEEDBACK_JSONL_PATH=data/feedback/feedback.jsonl
BADCASES_PENDING_PATH=data/feedback/badcases_pending.jsonl
